{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pacato",
  "version": "1.2.0",
  "identifier": "com.pacato.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pacato",
        "url": "https://www.youtube.com",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2RjkyQjlBMTkyODE3QzYKUldUR0Z5Z1ptaXY1dHFTNW5pZWNwNnQ3NkZGZVdWOGgxU0xPMlNvRlFCK3FPVkprRnZOWHJwTFIK",
      "endpoints": [
        "https://github.com/Flame0510/pacato/releases/latest/download/latest.json"
      ]
    }
  }
}
